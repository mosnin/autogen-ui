{
  "name": "@autogen-ui/core",
  "version": "0.3.0",
  "description": "Talk to an AI and watch your dashboard build itself. JSON-spec UI runtime on Tailwind + shadcn + Framer Motion with tool-use agent, streaming, dynamic data and forms.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "ai",
    "agent",
    "dashboard",
    "generative-ui",
    "anthropic",
    "claude",
    "openai",
    "tailwind",
    "shadcn",
    "framer-motion",
    "nextjs",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mosnin/autogen-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/mosnin/autogen-ui/issues"
  },
  "homepage": "https://github.com/mosnin/autogen-ui#readme",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./clients": {
      "types": "./dist/clients/index.d.ts",
      "import": "./dist/clients/index.js",
      "require": "./dist/clients/index.cjs"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js",
      "require": "./dist/style.cjs",
      "default": "./dist/style.js"
    },
    "./styles.css": "./src/styles.css",
    "./tailwind.preset": {
      "types": "./tailwind.preset.d.ts",
      "default": "./tailwind.preset.cjs"
    }
  },
  "files": [
    "dist",
    "src/styles.css",
    "tailwind.preset.cjs",
    "tailwind.preset.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx scripts/run-eval.ts",
    "smoke:llm": "tsx scripts/real-llm-smoke.ts",
    "probe:llm": "tsx scripts/quality-probe.ts",
    "example:node": "tsx scripts/node-server-example.ts",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "framer-motion": ">=11",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
